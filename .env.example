# ============================================================
# NEXUS v3 by Simplex - Variables de entorno
# Copia este archivo como .env y llena los valores reales
# ============================================================

# IA — Proveedores (orden de prioridad: Groq → Z.ai → OpenRouter → Ollama)
GROQ_API_KEY=gsk_...              # Groq gratis: console.groq.com (500k tokens/dia)
ZAI_API_KEY=...                   # Z.ai GLM-5: z.ai (fallback principal)
OPENROUTER_API_KEY=sk-or-v1-...   # OpenRouter Nemotron 120B: openrouter.ai (analisis background)
OLLAMA_URL=http://localhost:11434  # Ollama local: qwen2.5:7b + glm4 (offline)

# Base de datos
SUPABASE_URL=https://....supabase.co
SUPABASE_KEY=...

# Notificaciones
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...

# NEXUS config
NEXUS_PORT=8003
NEXUS_PRIVATE=1
NEXUS_OWNER=Anuar

# Negocios ATF / Milens
IG_USER=...
IG_PASS=...
ATF_PHONE=3323530146
FB_PAGE_TOKEN=...
FB_PAGE_ID=...

# MercadoLibre (activar cuando tengas el secret)
MELI_CLIENT_ID=...
MELI_CLIENT_SECRET=...
