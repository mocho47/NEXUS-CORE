# ============================================================
# NEXUS — Variables de entorno (.env.example)
# Copia este archivo como .env y llena los valores reales.
# NUNCA subas tu .env a Git — ya está en .gitignore.
# ============================================================

# --- Supabase (base de datos en la nube) ---
# Obtenlos en: supabase.com > tu proyecto > Settings > API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=eyJ...tu_anon_key...

# --- Groq AI (IA central — chat, voz, marketing, cerebro) ---
# Obtenlo en: console.groq.com > API Keys
GROQ_API_KEY=gsk_...tu_clave...

# --- Telegram Bot (notificaciones push al celular) ---
# Crea tu bot con @BotFather en Telegram, obtén el token
# TELEGRAM_CHAT_ID: el ID de tu chat personal (usa @userinfobot)
TELEGRAM_BOT_TOKEN=123456789:AAF...
TELEGRAM_CHAT_ID=987654321

# --- MercadoLibre (publicación de productos en ML) ---
# Crea una app en: developers.mercadolibre.com.mx
# Redirect URI debe ser: http://localhost:8000/api/meli/callback
MELI_CLIENT_ID=tu_client_id
MELI_CLIENT_SECRET=tu_client_secret
MELI_REDIRECT_URI=http://localhost:8000/api/meli/callback

# --- Meta / WhatsApp Business API (opcional, avanzado) ---
# Requiere cuenta de Meta for Developers y app aprobada
META_ACCESS_TOKEN=EAAx...
META_PHONE_NUMBER_ID=1234567890
META_WHATSAPP_NUMBER=521XXXXXXXXXX

# --- NEXUS — Configuración del nodo ---
# Nombre identificador del equipo (para logs y multi-instancia)
NEXUS_NODE_NAME=PC_MASTER

# Modo nube: "true" deshabilita features de escritorio (voz local, apps, etc.)
# Útil para deploy en Render/Railway. Por defecto: false (modo local)
CLOUD_MODE=false

# Features privadas (subliminales, módulos exclusivos). Activar en instalación propia.
NEXUS_PRIVATE=1

# --- Nexus Modo privacidad ---
# online: permite nube (Supabase, Groq, Telegram)
# offline: solo local, sin llamadas externas
# supervised: pide confirmación para operaciones sensibles
NEXUS_PRIVACY_MODE=online
NEXUS_DISABLE_CLOUD=0
