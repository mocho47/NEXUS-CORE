# ============================================================
# NEXUS — Variables de entorno (.env.example)
# Copia este archivo como .env y llena los valores reales.
# NUNCA subas tu .env a Git.
# ============================================================

# --- Supabase (base de datos en la nube) ---
# Obtenlos en: supabase.com > tu proyecto > Settings > API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=eyJ...tu_anon_key...

# --- Groq AI (generación de scripts y marketing con IA) ---
# Obtenlo en: console.groq.com > API Keys
GROQ_API_KEY=gsk_...tu_clave...

# --- Telegram Bot (notificaciones) ---
# Crea tu bot con @BotFather en Telegram, obtén el token
# TELEGRAM_CHAT_ID: el ID de tu chat personal (usa @userinfobot)
TELEGRAM_BOT_TOKEN=123456789:AAF...
TELEGRAM_CHAT_ID=987654321

# --- Meta / WhatsApp Business API (opcional, avanzado) ---
# Requiere cuenta de Meta for Developers y app aprobada
META_ACCESS_TOKEN=EAAx...
META_PHONE_NUMBER_ID=1234567890
META_WHATSAPP_NUMBER=521XXXXXXXXXX

# --- Nexus Modo ---
# online: permite nube (Supabase, Groq, Telegram)
# offline: solo local, sin llamadas externas
# supervised: pide confirmación para operaciones sensibles
NEXUS_PRIVACY_MODE=online
NEXUS_DISABLE_CLOUD=0
